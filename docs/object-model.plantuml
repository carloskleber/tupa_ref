@startuml

' Abstract classes
abstract class tMaterial {
    {field} epsilon : real(8)
    {field} mu : real(8)
    {field} sigma : real(8)
    {field} propagationConstant : complex(8)
    {abstract} +calcPropagationConstant(omega: real) : void
}

abstract class tElement {
    {field} id : character(256)
    {field} material : tMaterial (allocatable)
    {field} nNodes : integer(4)
    {field} nSegments : integer(4)
    {field} radius : real(8)
    {abstract} +init() : void
    {abstract} +assemble() : void
}

' Concrete Material implementations
class tLinear {
    +calcPropagationConstant(omega: real) : void
}

class tPortelaSoil {
    +calcPropagationConstant(omega: real) : void
}

' Per ADR 0007, further dispersive-soil subtypes (tLongmireSmithSoil,
' tVisacroAlipioSoil, ...) are siblings of tPortelaSoil under tMaterial,
' not variants folded into a single generic soil class.

' Concrete Element implementation
class tLine {
    {field} nodeStart : tNode (pointer)
    {field} nodeEnd : tNode (pointer)
    +init(nodeStart, nodeEnd, radius, nSegments, material, id) : void
    +assemble(...) : void
}

' Composite element: plants its own main nodes, then delegates each bar
' to a tLine (see ADR 0020) — JSON "type": "mesh", named tMeshElement to
' avoid colliding with the unrelated tMesh (linear-system) type below.
class tMeshElement {
    {field} position : real(8)(3)
    {field} lengthX, lengthY : real(8)
    {field} rowsX, rowsY : integer(4)
    {field} segments : integer(4)
    +assemble(...) : void
}

' Data types
class tNode {
    {field} id : character(256)
    {field} x : real(8)
    {field} y : real(8)
    {field} z : real(8)
    {field} voltage : complex(8)
}

class tElectrode {
    {field} id : character(256)
    {field} nNodes : integer(4)
    {field} nodeIndices : integer(:) (allocatable)
}

class tMesh {
    {field} tensao : complex(8)(:)
    {field} corrente1 : complex(8)(:)
    {field} corrente2 : complex(8)(:)
    {field} A : complex(8)(:,:)
    {field} B : complex(8)(:,:)
    {field} C : complex(8)(:,:)
    {field} D : complex(8)(:,:)
    {field} Ztrans : complex(8)(:,:)
    {field} Zlong : complex(8)(:,:)
    {field} Zeq : complex(8)(:,:)
    {field} cteEletAr : complex(8)
    {field} cteEletSolo : complex(8)
    {field} cteMagAr : complex(8)
    {field} cteMagSolo : complex(8)
    {field} propAr : complex(8)
    {field} propSolo : complex(8)
    {field} nno : integer(4)
    {field} nseg : integer(4)
    +initMesh(nn, ns) : void
    +calcTopologia(ns, n1, n2) : void
    +calcParam(omega, eps/mu/sigma air+soil) : void
    +setZ(i, j, zl, zt) : void
    +calcZPropria(i, pos, d, di, l, zint, g, gi, cosThetaI) : void
    +calcZMutua(i, j, pos1, pos2, d, di, la, lb, g, gi, cosTheta, cosThetaI) : void
    +calcFreq2() : void
    +injetaSinalF(nsig, pos, sig) : integer(4)
    +getSaidas(nn, ns, v, i1, i2) : void
}

note right of tMesh
  Solution x = [u, i1, i2]: tensao = node voltages,
  corrente1/corrente2 = END currents i1/i2 (both into
  the segment, theory.md §6); Il=(i1-i2)/2, It=i1+i2.
  calcZ* consume raw mGeometry outputs (ADR 0009).
end note

class tStructure {
    {field} nodes : tNode(:) (allocatable, dynamic array)
    {field} electrodes : tElectrode(:) (allocatable, dynamic array)
    {field} elements : linked list of tElement
    {field} materials : linked list of tMaterial
    {field} soil : tMaterial (allocatable)
    {field} air : tLinear
    {field} nodeCount, electrodeCount : integer
    {field} elementCount, materialCount : integer
    +addNode(node) / getNodeCount() / findNodeIndex(id)
    +addElectrode(electrode) / getElectrodeCount()
    +addElement(element) / getElement(i) / getElementCount()
    +addMaterial(material) / getMaterial(i) / findMaterial(id)
    +assembleStructure() : void
}

class tStudy {
    {field} title : character(256)
    {field} structure : tStructure
    {field} mesh : tMesh
}

' Helper module
class mNode_createNode {
    {static} +createNode(id, x, y, z) : tNode
}

' Inheritance relationships
tLinear --> tMaterial
tPortelaSoil --> tMaterial
tLine --> tElement
tMeshElement --> tElement

' Composition/Association relationships
tElement --> tMaterial : has
tLine --> tNode : points to (nodeStart)
tLine --> tNode : points to (nodeEnd)
tMeshElement --> tLine : creates one per bar (composite)
tStructure --> tNode : contains (array)
tStructure --> tElectrode : contains (array)
tStructure --> tElement : contains (linked list)
tStructure --> tMaterial : contains (linked list)
tStructure --> tMaterial : has (soil)
tStudy --> tStructure : has
tStudy --> tMesh : has
tMesh --> tElectrode : uses (in methods)

' Constructor function
mNode_createNode --> tNode : creates

note right of tMaterial
  Abstract type for electromagnetic materials
  Used by tElement instances
  Supports polymorphic behavior
end note

note right of tElement
  Abstract element type
  Extended by tLine for transmission lines
  Can be extended for other element types
end note

note right of tStructure
  Container for nodes, elements, and materials
  Manages dynamic arrays with auto-expansion
  Part of the problem domain modeling
end note

note right of tStudy
  Top-level study container
  Aggregates structure and mesh
  Represents a complete analysis case
end note

@enduml
