{
  "title": "ROADMAP Phase 10b: strike to a 30 m tower with a 3 m footing, loaded 1 km channel, current source between channel base and tower top (ADR 0025)",
  "soil": { "conductivity": 0.001, "permittivity": 10.0, "permeability": 1.0 },
  "nodes": [
    { "id": "Tfoot", "position": [0.0, 0.0, 0.0] },
    { "id": "Ttop", "position": [0.0, 0.0, 30.0] },
    { "id": "Rend", "position": [0.0, 0.0, -3.0] }
  ],
  "materials": [
    { "id": "steel", "epsilonr": 1.0, "mur": 1.0, "sigma": 5.0e6 }
  ],
  "elements": [
    { "type": "line", "id": "Tower", "from": "Tfoot", "to": "Ttop", "radius": 0.3, "segments": 6, "material": "steel" },
    { "type": "line", "id": "Rod", "from": "Tfoot", "to": "Rend", "radius": 0.0125, "segments": 3, "material": "steel" },
    { "type": "channel", "id": "ch", "strike": "Ttop", "length": 1000.0, "radius": 0.03,
      "speed": 1.5e8, "resistance": 0.5,
      "firstSegment": 5.0, "growth": 1.2, "maxSegment": 50.0 }
  ],
  "sources": [
    { "node": "Ttop", "returnNode": "ch-base", "current": { "re": 1.0, "im": 0.0 } }
  ],
  "frequencies": { "min": 1.0e4, "max": 1.0e6, "pointsPerDecade": 3 },
  "outputs": {
    "nodes": ["Ttop", "Tfoot", "ch-base"],
    "electrodes": ["ch_e1", "Tower_e1", "Rod_e1"],
    "quantities": ["voltage", "i1", "i2", "inputImpedance"]
  },
  "signal": {
    "sources": [
      { "node": "Ttop", "returnNode": "ch-base", "waveform": "portela", "imax": 1.0e4, "alpha": 0.0,
        "tFront": 1.0e-6, "tTopEnd": 5.0e-6, "tTailEnd": 2.0e-5 }
    ],
    "observeNodes": ["Ttop", "ch-base"],
    "observeElectrodes": ["ch_e1", "Tower_e1"],
    "nyquistHz": 2.0e6,
    "fftPoints": 256,
    "transform": "nlt"
  }
}
