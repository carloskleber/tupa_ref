{
  "title": "Small buried grounding grid (single square mesh)",
  "soil": {
    "conductivity": 0.01,
    "permittivity": 10.0,
    "permeability": 1.0
  },
  "nodes": [
    { "id": "Node_A", "position": [0.0,  0.0,  -0.5] },
    { "id": "Node_B", "position": [10.0, 0.0,  -0.5] },
    { "id": "Node_C", "position": [10.0, 10.0, -0.5] },
    { "id": "Node_D", "position": [0.0,  10.0, -0.5] }
  ],
  "materials": [
    { "id": "copper", "epsilonr": 1.0, "mur": 1.0, "sigma": 5.96e7 }
  ],
  "elements": [
    { "type": "line", "id": "Line_1", "from": "Node_A", "to": "Node_B", "radius": 0.01, "segments": 1, "material": "copper" },
    { "type": "line", "id": "Line_2", "from": "Node_B", "to": "Node_C", "radius": 0.01, "segments": 1, "material": "copper" },
    { "type": "line", "id": "Line_3", "from": "Node_C", "to": "Node_D", "radius": 0.01, "segments": 1, "material": "copper" },
    { "type": "line", "id": "Line_4", "from": "Node_D", "to": "Node_A", "radius": 0.01, "segments": 1, "material": "copper" }
  ],

  "sources": [ { "node": "Node_A", "current": { "re": 1.0, "im": 0.0 } } ],
  "frequencies": { "min": 100.0, "max": 1.0e5, "pointsPerDecade": 1 },
  "outputs": {
    "quantities": ["voltage", "i1", "i2", "inputImpedance"]
  }
}
