  },
  "signal": {
    "sourceNode": "A0",
    "waveform": "heidler",
    "imax": 1000.0,
    "terms": [
      { "i0": 1000.0, "n": 10.0, "tau1": 5e-07, "tau2": 2e-06 }
    ],
    "observeNodes": ["A0", "A1000", "G0", "G1000"],
    "nyquistHz": 5000000.0,
    "fftPoints": 1024,
    "transform": "nlt"
  }
}
