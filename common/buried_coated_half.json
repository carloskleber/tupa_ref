{
  "title": "Buried 1000 m wire, first half coated (XLPE-like insulation), second half bare - Heidler surge, up to 5 MHz",
  "soil": {
    "conductivity": 0.01,
    "permittivity": 10.0,
    "permeability": 1.0
  },
  "nodes": [
    { "id": "N0", "position": [0.0,    0.0, -1.0] },
    { "id": "N1", "position": [500.0,  0.0, -1.0] },
    { "id": "N2", "position": [1000.0, 0.0, -1.0] }
  ],
  "materials": [
    { "id": "copper", "epsilonr": 1.0, "mur": 1.0, "sigma": 5.96e7 },
    { "id": "xlpe",   "epsilonr": 2.3, "mur": 1.0, "sigma": 1.0e-12 }
  ],
  "elements": [
    {
      "type": "line",
      "id": "Coat",
      "from": "N0",
      "to": "N1",
      "radius": 0.007,
      "segments": 100,
      "material": "copper",
      "coating": { "outerRadius": 0.012, "material": "xlpe" }
    },
    {
      "type": "line",
      "id": "Bare",
      "from": "N1",
      "to": "N2",
      "radius": 0.007,
      "segments": 100,
      "material": "copper"
    }
  ],

  "signal": {
    "waveform": "heidler",
    "terms": [ { "i0": 10000.0, "n": 10, "tau1": 1.8e-6, "tau2": 9.5e-5 } ],
    "sourceNode": "N0",
    "observeNodes": ["N0", "Coat_n25", "Coat_n50", "Coat_n75", "N1", "Bare_n25", "Bare_n50", "Bare_n75", "N2"],
    "observeElectrodes": ["Coat_e1", "Coat_e50", "Coat_e100", "Bare_e1", "Bare_e50", "Bare_e100"],
    "nyquistHz": 5.0e6,
    "fftPoints": 4096
  }
}
