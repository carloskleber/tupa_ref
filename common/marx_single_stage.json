{
  "title": "Marx generator, one stage: charged 1 nF at 100 kV into a 50 ohm load through R = 2 ohm, L = 0.5 uH (Norton form, docs/marx_generator.md)",
  "soil": { "conductivity": 0.01, "permittivity": 10.0, "permeability": 1.0 },
  "nodes": [
    { "id": "Cap",    "position": [0.0, 0.0, 5.0] },
    { "id": "Node_1", "position": [20.0, 0.0, -0.5] },
    { "id": "Node_2", "position": [25.0, 0.0, -0.5] }
  ],
  "materials": [ { "id": "copper", "epsilonr": 1.0, "mur": 1.0, "sigma": 5.96e7 } ],
  "elements": [
    { "type": "line", "id": "Rod", "from": "Node_1", "to": "Node_2", "radius": 0.01, "segments": 2, "material": "copper" },
    { "type": "branch", "id": "Marx", "from": "Cap", "resistance": 2.0, "inductance": 5.0e-7, "capacitance": 1.0e-9 },
    { "type": "branch", "id": "Load", "from": "Cap", "resistance": 50.0 }
  ],
  "signal": {
    "waveform": "branchNorton",
    "imax": 100000.0,
    "resistance": 2.0,
    "inductance": 5.0e-7,
    "capacitance": 1.0e-9,
    "sourceNode": "Cap",
    "observeNodes": [ "Cap" ],
    "nyquistHz": 1.0e8,
    "fftPoints": 4096,
    "transform": "nlt"
  }
}
