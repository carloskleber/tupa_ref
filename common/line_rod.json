  },
  "nodes": [
    { "id": "Node_0", "position": [  0.0, 0.0, 30.0] },
    { "id": "Node_1", "position": [300.0, 0.0, 30.0] },
    { "id": "Node_2", "position": [300.0, 0.0,  0.0] },
