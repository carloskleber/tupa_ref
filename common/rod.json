{
  "title": "Vertical driven ground rod",
  "soil": {
    "conductivity": 0.01,
    "permittivity": 10.0,
    "permeability": 1.0
  },
  "nodes": [
    { "id": "Node_1", "position": [0.0, 0.0, -0.5] },
    { "id": "Node_2", "position": [0.0, 0.0, -3.5] }
  ],
  "materials": [
    { "id": "copper", "epsilonr": 1.0, "mur": 1.0, "sigma": 5.96e7 }
  ],
  "elements": [
    {
      "type": "line",
      "id": "Rod_1",
      "from": "Node_1",
      "to": "Node_2",
      "radius": 0.01,
      "segments": 6,
      "material": "copper"
    }
  ],

  "sources": [ { "node": "Node_1", "current": { "re": 1.0, "im": 0.0 } } ],
  "frequencies": { "min": 10.0, "max": 1.0e6, "pointsPerDecade": 1 },
  "outputs": {
    "quantities": ["voltage", "i1", "i2", "inputImpedance"]
