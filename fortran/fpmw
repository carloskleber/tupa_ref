#!/bin/bash
# fpm wrapper: sets the project compiler flags (free-form long lines, no range
# check, OpenMP), then forwards everything to fpm, e.g.
#   ./fpmw run -- ../common/marx_single_stage.json
# (for an optimised install use build.sh).
export FPM_FFLAGS="${FPM_FFLAGS:--ffree-line-length-none -fno-range-check -fopenmp}"
exec fpm "$@"
